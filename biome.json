{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/routeTree.gen.ts",
      "!**/dist",
      "!**/node_modules",
      "!**/playwright-report",
      "!**/test-results",
      "!**/pnpm-lock.yaml",
      "!**/.claude/settings.local.json"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 80 },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/features/*/**"],
                "message": "Import features through their public index.ts."
              },
              {
                "group": ["@/mocks/**"],
                "message": "Mocks belong to development and tests only."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import features through their public index.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/shared/components/ui/**"],
      "plugins": [
        "./biome-plugins/no-native-elements.grit",
        "./biome-plugins/no-as-child.grit",
        "./biome-plugins/no-palette-colors.grit",
        "./biome-plugins/no-arbitrary-values.grit",
        "./biome-plugins/no-leading-slash-api-path.grit"
      ],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "error" },
          "performance": { "noNamespaceImport": "error" }
        }
      }
    },
    {
      "includes": ["src/routes/**"],
      "plugins": ["./biome-plugins/loader-prefetches.grit"]
    },
    {
      "includes": [
        "src/**",
        "!src/routes/__root.tsx",
        "!src/shared/components/ui/**"
      ],
      "plugins": ["./biome-plugins/single-toaster.grit"]
    },
    {
      "includes": ["src/features/*/*.ts", "src/features/*/*.tsx"],
      "plugins": ["./biome-plugins/module-root-boundary.grit"]
    },
    {
      "includes": ["src/features/*/*/**"],
      "plugins": ["./biome-plugins/module-boundary.grit"]
    },
    {
      "includes": ["src/shared/**", "!src/shared/components/ui/**"],
      "plugins": ["./biome-plugins/shared-without-features.grit"]
    },
    {
      "includes": ["src/shared/components/ui/**"],
      "linter": { "enabled": false }
    }
  ]
}
